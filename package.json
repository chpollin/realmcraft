{
  "name": "realmcraft",
  "version": "0.1.0",
  "private": true,
  "description": "RealmCraft — Spielstand-Dashboard für ein spielleitergeführtes Aufbau- und Erzählspiel. Lädt einen Speicherstand und rendert Lage, Berater, Akteure und Karte; KI-Bilder via Gemini (Nano Banana).",
  "type": "module",
  "scripts": {
    "serve": "node serve.mjs",
    "check": "node tools/check.mjs",
    "validate:savegame": "node tools/check.mjs savegame.json",
    "test": "npm run check && npm run test:unit && npm run test:acceptance",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "playwright test --project=e2e",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:strategy": "node --test tests/unit/strategy.test.js && playwright test --project=e2e tests/e2e/strategy.spec.js",
    "test:nachtmeer": "node --test tests/unit/nachtmeer.test.js tests/unit/nachtmeer-presentation.test.js",
    "simulate:nachtmeer": "node design/nachtmeer-simulate.mjs",
    "report": "playwright show-report",
    "test:acceptance": "node --test \"tests/acceptance/**/*.test.js\"",
    "sim": "node tools/sim/run.mjs",
    "sim:balance": "node tools/sim/run.mjs --seeds 24 --seasons 40 --out tools/sim/out/balance-report.json",
    "test:fuzz": "node tools/sim/fuzz.mjs --runs 20 --seeds 1,2,3"
  },
  "engines": {
    "node": ">=21"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "ajv": "^8.17.1",
    "sharp": "^0.34.5"
  },
  "license": "MIT"
}
