{
  "name": "realmcraft",
  "version": "0.1.0",
  "private": true,
  "description": "RealmCraft, a turn-based open-world strategy game with a deterministic rules kernel, world packages, an AI harness in Claude Code and a map-first browser board.",
  "type": "module",
  "scripts": {
    "serve": "node serve.mjs",
    "check": "node tools/check.mjs",
    "test": "npm run check && npm run test:unit && npm run test:acceptance",
    "test:unit": "node --test \"tests/unit/**/*.test.js\"",
    "test:e2e": "playwright test --project=e2e",
    "portraits": "node tools/portraits/generate.mjs",
    "report": "playwright show-report",
    "test:acceptance": "node --test \"tests/acceptance/**/*.test.js\"",
    "sim": "node tools/sim/run.mjs",
    "sim:balance": "node tools/sim/run.mjs --seeds 24 --seasons 40 --out tools/sim/out/balance-report.json",
    "test:fuzz": "node tools/sim/fuzz.mjs --runs 20 --seeds 1,2,3"
  },
  "engines": {
    "node": ">=21"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "ajv": "^8.17.1",
    "sharp": "^0.34.5"
  },
  "license": "MIT"
}
